# Copiar para ~/bookstore/.env (chmod 600). Gerar cada valor aleatorio com:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(50))'
DEBUG=0
SECRET_KEY=<gerar>
DJANGO_ALLOWED_HOSTS=bookstore.maxhaider.dev localhost
CSRF_TRUSTED_ORIGINS=https://bookstore.maxhaider.dev
POSTGRES_USER=bookstore
POSTGRES_DB=bookstore
POSTGRES_PASSWORD=<gerar>
# mesma senha do POSTGRES_PASSWORD; host "db" e o servico do compose
DATABASE_URL=<postgres://USUARIO:SENHA@db:5432/NOME>
